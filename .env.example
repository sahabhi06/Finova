# Copy this file to .env and fill in real values.
# Load it with: export $(cat .env | xargs)   -- or use python-dotenv.

# --- Safety switch: leave both of these OUT (or TRADING_MODE unset) to run
# --- on testnet by default. Only add both, deliberately, when ready to go live.
# TRADING_MODE=live
# I_UNDERSTAND_THIS_USES_REAL_MONEY=yes

# --- Testnet credentials (get these free from testnet.binance.vision) ---
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_here

# --- Live credentials (only needed once TRADING_MODE=live) ---
# BINANCE_API_KEY=your_real_key_here
# BINANCE_API_SECRET=your_real_secret_here

# --- Bot behavior ---
BOT_SYMBOL=BTCUSDT
BOT_INTERVAL=15m
BOT_LOOP_SECONDS=60

# --- Strategy parameters (SMA windows, RSI, trend filter) ---
# Run grid_search.py to find the best values for current market conditions.
FAST_WINDOW=20
SLOW_WINDOW=50
TREND_FILTER_WINDOW=100
RSI_WINDOW=14
RSI_OVERBOUGHT=70

# --- Risk policy: change these numbers, don't remove the checks ---
MAX_POSITION_USDT=100
DAILY_LOSS_CAP_USDT=100
MAX_TRADES_PER_DAY=10
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06

# --- Trailing stop-loss (stop ratchets up as price rises, locking profits) ---
TRAILING_STOP=true
TRAIL_PCT=0.03

# --- ATR-based volatility position sizing ---
# Sizes each position so that a stop-loss hit costs exactly RISK_PER_TRADE_PCT
# of your account balance. Smaller bets in volatile markets, larger in calm.
ATR_SIZING=true
ATR_WINDOW=14
ATR_MULTIPLIER=2.0
RISK_PER_TRADE_PCT=0.02
